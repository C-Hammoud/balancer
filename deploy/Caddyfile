# Web server: serves the Angular app and forwards the API to Django.
# SITE_ADDRESS=:80            -> plain HTTP on the server's IP (no domain yet)
# SITE_ADDRESS=app.example.com -> automatic HTTPS certificate from Let's Encrypt (needs a domain
#                                pointing at this server and ports 80 + 443 open)
{
	email {$ACME_EMAIL:admin@example.com}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Django admin assets (collected by the API container into the shared "static" volume).
	handle /static/* {
		root * /srv
		file_server
	}

	# Health checks are internal only: Docker's healthcheck calls the API container directly
	# (127.0.0.1:8000), so from the internet these answer 404.
	@health path /healthz /healthz/ /api/v1/health /api/v1/health/
	handle @health {
		respond 404
	}

	# /django-admin/ is Django's built-in admin; /admin/... is the web app's admin area (below).
	@backend path /api/* /django-admin /django-admin/*
	handle @backend {
		reverse_proxy api:8000
	}

	# Angular app: unknown paths fall back to index.html (client-side routes).
	handle {
		root * /srv/app
		# Build files with a content hash in the name (main-ABCD1234.js) never change: cache them for
		# a year. Everything else (index.html and app routes, ngsw.json, ngsw-worker.js, the manifest,
		# icons) is checked with the server on each use, so the installed app (PWA) picks up a new
		# version right after a deploy.
		@hashed path_regexp -[A-Z0-9]+\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path_regexp -[A-Z0-9]+\.(js|css)$
		header @unhashed Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
