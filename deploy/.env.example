# Production settings for docker compose. Copy to deploy/.env on the server and fill in.
#   cp deploy/.env.example deploy/.env && nano deploy/.env
# deploy/.env is git-ignored: never commit it.

# ---- Required secrets --------------------------------------------------------
# Generate each with:  openssl rand -hex 32
# (hex only: the database password is placed inside a URL, so avoid / + = characters)
DJANGO_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# Database name and user (created automatically on the first start)
POSTGRES_DB=balancer
POSTGRES_USER=balancer

# ---- Address of the server ---------------------------------------------------
# Without a domain: the server's public IP, plain HTTP.
#   SITE_ADDRESS=:80 and the HTTPS switches below at 0.
# With a domain (A record -> this IP): SITE_ADDRESS=app.example.com, all URLs https://,
#   DJANGO_SECURE_SSL_REDIRECT=1 and DJANGO_HSTS_SECONDS=3600 (raise to 31536000 once it works).
SITE_ADDRESS=:80
ACME_EMAIL=you@example.com
DJANGO_ALLOWED_HOSTS=203.0.113.10
CORS_ALLOWED_ORIGINS=http://203.0.113.10
CSRF_TRUSTED_ORIGINS=http://203.0.113.10
# Links in emails (verification, password reset, support): the web app and the API.
FRONTEND_URL=http://203.0.113.10
API_PUBLIC_URL=http://203.0.113.10/api/v1
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0

# ---- Email (Gmail: use an App password, never your account password) -------
EMAIL_ENABLED=1
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=you@gmail.com
EMAIL_APP_NAME=Finance Tracker
SUPPORT_EMAIL=
# 0 = alert / reminder emails only print to the logs; account emails are always sent.
NOTIFICATION_EMAILS_ENABLED=0
REQUIRE_EMAIL_VERIFICATION=1

# ---- Optional ------------------------------------------------------------------
LOG_LEVEL=INFO
# Mobile app link scheme used in emailed links
MOBILE_APP_SCHEME=financetracker
# Support tickets: least_busy | round_robin | pool (until a superuser saves Support settings)
SUPPORT_ASSIGNMENT_MODE=least_busy
SUPPORT_REMINDER_DAYS=3
SUPPORT_AUTO_CLOSE_DAYS=7
# Background job intervals in minutes, e.g. SCHEDULE_BUDGET_ALERTS_MINUTES=15
# Jobs: BUDGET_ALERTS, SETUP_NUDGES, SUPPORT_TICKETS, RISK, COMMITMENT_REMINDERS, BUDGET_PLANS, BACKUP
# Number of nightly database backups kept in deploy/backups
BACKUP_KEEP=14
# Exchange rates (value of 1 unit in USD), e.g. EXCHANGE_RATES={"LBP": 0.0000112}
# EXCHANGE_RATES=
# EXCHANGE_RATES_AS_OF=2026-10-27
