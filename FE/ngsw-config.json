{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**",
    "!/django-admin/**",
    "!/static/**"
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-read",
      "urls": [
        "/api/v1/budgeting/**",
        "/api/v1/risk/**",
        "/api/v1/notifications/**",
        "https://balancer-api.onrender.com/api/v1/budgeting/**",
        "https://balancer-api.onrender.com/api/v1/risk/**",
        "https://balancer-api.onrender.com/api/v1/notifications/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxAge": "7d",
        "maxSize": 300
      }
    }
  ]
}
